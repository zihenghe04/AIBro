{
  "name": "ai-bro",
  "productName": "AI Bro",
  "version": "0.9.2",
  "private": true,
  "description": "AI native personal knowledge and task workstation",
  "main": "app/electron-main.js",
  "scripts": {
    "start": "./scripts/run-electron.sh",
    "dev": "./scripts/run-electron.sh",
    "app": "./scripts/build-electron-app.sh",
    "app:electron": "./scripts/build-electron-app.sh",
    "dist": "electron-builder --config scripts/electron-builder.config.cjs --mac",
    "predist": "node app/build-native-glass.js --optional",
    "assets:check": "node app/app-assets.js",
    "test:server": "python3 scripts/run-server-tests.py",
    "test": "node --test tests/*.test.js tests/*.test.cjs && npm run test:server && npm run assets:check",
    "test:cloud": "python3 cloud/run-tests.py",
    "native:build": "node app/build-native-glass.js",
    "release:mac": "node scripts/release-native.js",
    "demo:record": "electron scripts/record-demo.cjs",
    "demo:render": "python3 scripts/render-demo.py",
    "test:native": "./scripts/test-native-localization.sh && ./scripts/test-native-desktop.sh && ./scripts/test-native-agenda.sh && sh ./scripts/test-native-vector-store.sh",
    "start:native": "./scripts/run-native-preview.sh",
    "build:native": "./scripts/run-native-preview.sh --build-only",
    "build:ui": "node scripts/build-halaska-ui.mjs",
    "build:editors": "node scripts/build-document-editors.mjs",
    "test:halaska": "electron tests/halaska-kit-smoke.cjs",
    "build:document-markdown": "node scripts/build-document-markdown.mjs"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "linkedom": "0.18.12"
  },
  "build": {
    "appId": "app.ai-workstation.studio",
    "productName": "AI Bro",
    "mac": {
      "target": "dir",
      "icon": "app/ai-bro-icon.icns"
    }
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@milkdown/crepe": "7.22.2",
    "@milkdown/kit": "7.22.2",
    "codemirror": "6.0.2",
    "d3": "7.9.0",
    "framer-motion": "13.4.4",
    "katex": "0.18.9",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/zihenghe04/AIBro.git"
  }
}
