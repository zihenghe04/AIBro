{
  "name": "aibro-mobile",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8899",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "build:web": "vite build --outDir web-dist && node scripts/build-web.mjs",
    "preview:web": "vite preview --outDir web-dist --host 127.0.0.1 --port 8900"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@js-temporal/polyfill": "^0.5.1",
    "diff": "^9.0.0",
    "dompurify": "^3.3.0",
    "fflate": "^0.8.2",
    "ical.js": "^2.2.1",
    "marked": "^17.0.0",
    "pdfjs-dist": "^5.7.284",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.58.0",
    "prettier": "^3.9.6",
    "vite": "^7.0.0",
    "xcode": "^3.0.1"
