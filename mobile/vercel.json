{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "web-dist",
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Frame-Options","value":"DENY"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]}
  ],
  "rewrites": [{"source":"/((?!api/|assets/|sw.js|manifest.webmanifest|brand.png).*)","destination":"/index.html"}]
}
